#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/bt.h>

/*
 * Translated from macrodot-firmware keymap.
 * Key differences preserved:
 * - Bluetooth support retained (CONFIG_ZMK_BLE enabled in .conf)
 * - Uses 'label' instead of 'display-name' (ZMK convention)
 * - Sticky keys (&sk) for persistent modifiers
 * - Hold-tap 'nav' behavior for navigation keys
 */

&key_repeat {
      usage-pages = <HID_USAGE_KEY HID_USAGE_CONSUMER>;
};

/ {
    behaviors {
        /* Hold–tap: tap-preferred, 200 ms tap term. Hold = first param, tap = second. */
        nav: hold-tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Linux";

            bindings = <
                /* Row 1: F1, 1–5, Esc */
                &kp LS(LG(SLASH)) &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp ESC

                /* Row 2: F2, PgUp, Mod+T, Up (tap) / Mod+i (hold), Mod+d, Mod+Shift+F, PrtSc */
                &sk LGUI &kp PG_UP &kp LG(T) &nav LG(I) UP &kp LG(D) &kp LS(LG(F)) &kp PRINTSCREEN

                /* Row 3: F3 sk Mod+Ctrl, PgDn, arrows + Ins, Num (unbound) */
                &sk LG(LCTRL) &kp PG_DN &nav LS(LG(LEFT)) LEFT &nav LG(U) DOWN &nav LS(LG(RIGHT)) RIGHT &kp LS(LC(LG(LA(F)))) &none

                /* Row 4: F4 sk Mod+Shift+Ctrl, 6–9, *→Mod+Home, End→Mod+End */
                &sk LS(LG(LCTRL)) &kp N6 &kp N7 &kp N8 &kp N9 &kp LG(HOME) &kp LG(END)

                /* Row 5: F5–F8 stickies, volume mute, mic mute (F20), sleep */
                &sk LG(LALT) &sk LGUI &sk LS(LG(LCTRL)) &sk LA(LCTRL) &kp C_MUTE &kp F20 &kp C_SLEEP
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            label = "Lower";
            bindings = <
                &none &none &none &none &none &none &none
                &none &trans &none &none &none &none &none
                &none &trans &none &none &none &none &none
                &none &trans &none &none &none &none &none
                &none &trans &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        settings_layer {
            label = "Settings";
            bindings = <
                &none &none &bt BT_CLR &none &none &none &none
                &none &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &none &trans &none &none &none &none &none
                &none &trans &none &none &none &none &none
                &none &trans &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
        };
    };
};

/* Default mod-tap tap term 200 ms */
&mt {
    tapping-term-ms = <200>;
};